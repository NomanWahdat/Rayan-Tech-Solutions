{
  "name": "rayan-tech-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional software development company website",
  "author": "Rayan Tech Solutions",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-website-translations.mjs && tsc && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "i18n:build": "node scripts/build-website-translations.mjs",
    "preview": "vite preview",
    "format": "prettier --write src scripts tests netlify index.html vite.config.ts playwright.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests netlify index.html vite.config.ts playwright.config.ts package.json tsconfig.json",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:api": "node --test tests/inquiry-api.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.424.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "^3.9.9",
    "typescript": "^5.4.5",
    "vite": "^8.3.4"
  }
}
