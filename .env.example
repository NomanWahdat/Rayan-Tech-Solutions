# Optional override; defaults to the included /api/inquiry server function.
# Must accept JSON POST and return HTTP 2xx with { "success": true } only
# after the inquiry has actually been accepted. Configure CORS for the site.
# No secret belongs in a VITE_ variable; these values are public.
VITE_CONTACT_ENDPOINT=

# PRIVATE server-side variables. Configure these on the host, never as VITE_ variables.
# Sender must belong to a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Recipient defaults to the owner's requested private mailbox in the server function.
CONTACT_TO_EMAIL=
